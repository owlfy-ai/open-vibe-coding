# Open Vibe Coding currently stores most runtime configuration in the app settings UI.
# This file is intentionally minimal and documents optional build-time values.

# Set when deploying the Vite app under a subpath, such as GitHub Pages.
# Example: /open-vibe-coding/
VITE_BASE_PATH=

# Required for the online build. Clerk publishable keys are public browser
# configuration; never put the Clerk secret key in a VITE_* variable.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsucWlkZWEuYWkk
VITE_OVC_APP_ID=qidea.ai
VITE_OVC_BACKEND_URL=https://api.owlfy.ai
